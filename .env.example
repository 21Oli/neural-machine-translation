# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Data ---
# Root path for raw data downloads
DATA_DIR=data/raw

# HuggingFace dataset cache directory (optional)
HF_DATASETS_CACHE=data/external/.hf_cache

# --- Paths ---
MODELS_DIR=models
ARTIFACTS_DIR=artifacts

# --- Training ---
# Set to "cuda", "mps", or "cpu"
DEVICE=cuda

# Random seed for reproducibility
SEED=42

# --- Logging ---
# "DEBUG", "INFO", "WARNING", "ERROR"
LOG_LEVEL=INFO
LOG_DIR=reports

# TensorBoard log directory
TENSORBOARD_DIR=reports/tensorboard

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=false
